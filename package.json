{
	"name": "marimo-notes",
	"version": "0.2.2",
	"description": "Run marimo notebooks as live, reactive Python cells inside your notes. Python runs in-browser via Pyodide.",
	"main": "main.js",
	"packageManager": "pnpm@9.1.1",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"vault": "bash scripts/open-vault.sh",
		"check:fences": "node scripts/check-fences.mjs"
	},
	"keywords": [
		"obsidian",
		"marimo",
		"notebook"
	],
	"author": "Kiran Gadhave",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "^22.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0"
	}
}
